{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>chill-institute/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Digest-pinned scanner images in the scan action's docker run commands",
      "managerFilePatterns": ["/^\\.github/actions/scan/action\\.yml$/"],
      "matchStrings": [
        "(?<depName>ghcr\\.io/gitleaks/gitleaks|rhysd/actionlint|ghcr\\.io/zizmorcore/zizmor):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
